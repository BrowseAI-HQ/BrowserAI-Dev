{
  "git": {
    "deploymentEnabled": {
      "shreyas": false
    }
  },
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "browseai.dev"
        }
      ],
      "destination": "https://lastsearch.ai/:path",
      "permanent": true
    },
    {
      "source": "/:path((?!api/).*)",
